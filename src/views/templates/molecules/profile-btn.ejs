<%
  // Molecule: profile button (spectsEccomerce/layouts/ProfileBtn.png).
  // Graphite pill with the avatar atom and the user name, both via locals.
  // Auth (spec §23): `data-auth-profile` + `data-auth-name` los hidrata auth.js
  // (invitado → link a /login; logueado → nombre real). El href por defecto es
  // /login para funcionar incluso sin JS.
  const profileName = typeof name === "string" && name.trim() ? name.trim() : "Invitado";
  const profileHref = typeof href === "string" && href ? href : "/login";
%>
<a
  href="<%= profileHref %>"
  data-auth-profile
  class="flex h-10 shrink-0 items-center gap-2 rounded-full bg-graphite pl-1.5 pr-4 text-white transition-colors hover:bg-graphite/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-graphite"
  aria-label="Perfil de <%= profileName %>"
>
  <%- include("../atoms/profile-pic", { name: profileName }) %>
  <span class="text-sm" data-auth-name><%= profileName %></span>
</a>
