<%
  // Molecule: right cluster of the header (spectsEccomerce/layouts/Header-Right.png)
  // = cart-icon molecule + profile-btn molecule with a small gap.
  const rightCartCount = typeof cartCount === "number" && cartCount >= 0 ? cartCount : 0;
  const rightUserName = typeof userName === "string" ? userName : "";
%>
<div class="flex shrink-0 items-center gap-2">
  <%- include("./cart-icon", { count: rightCartCount }) %>
  <%- include("./profile-btn", { name: rightUserName }) %>
  <button
    type="button"
    data-auth-logout
    class="hidden rounded-full px-2 text-sm text-graphite underline-offset-2 hover:underline"
  >
    Salir
  </button>
</div>
