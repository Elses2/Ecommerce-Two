<%
  // Page: Order confirmation (spec §19, D7): la confirmación se accede por
  // checkout_token, nunca por orders.id. Locals (checkoutController.
  // showConfirmation): order (Order — total, estado, datos de envío) e items
  // (OrderItemWithProduct[] — unit_price congelado al momento de la compra,
  // spec §1.1; el subtotal se recalcula acá como quantity × unit_price).
  const statusLabels = {
    pending: "Pendiente",
    paid: "Pagada",
    failed: "Fallida",
    cancelled: "Cancelada",
  };
  const statusLabel = statusLabels[order.status] ?? order.status;
%>
<section class="mx-auto w-full max-w-2xl px-4 py-10 md:py-16">
  <div class="rounded-2xl bg-white p-6 text-center shadow-md md:p-10">
    <h1 class="text-h2 text-ink">¡Gracias por tu compra!</h1>
    <p class="mt-3 text-muted">Tu orden fue confirmada correctamente.</p>
    <p class="mt-4 text-sm text-ink">
      Número de orden: <span class="font-bold"><%= order.id %></span>
    </p>
    <p class="mt-1 text-sm text-ink">
      Estado: <span class="font-bold"><%= statusLabel %></span>
    </p>
  </div>

  <div class="mt-6 rounded-2xl bg-white p-6 shadow-md">
    <h2 class="text-h3 text-ink">Detalle de tu compra</h2>
    <ul class="mt-4 flex flex-col gap-3">
      <% items.forEach((item) => { %>
        <li class="flex items-baseline justify-between gap-4 text-sm">
          <span class="text-ink">
            <%= item.product_name %>
            <span class="text-muted">× <%= item.quantity %></span>
          </span>
          <span class="font-medium text-ink"><%= (item.quantity * item.unit_price).toLocaleString("es-AR") %></span>
        </li>
      <% }) %>
    </ul>
    <p class="mt-4 flex items-baseline justify-between border-t border-neutral-200 pt-4">
      <span class="text-ink">Total</span>
      <span class="text-xl font-bold text-ink"><%= order.total.toLocaleString("es-AR") %></span>
    </p>
  </div>

  <div class="mt-6 rounded-2xl bg-white p-6 shadow-md">
    <h2 class="text-h3 text-ink">Datos de envío</h2>
    <dl class="mt-4 grid gap-x-4 gap-y-3 text-sm text-ink sm:grid-cols-2">
      <div>
        <dt class="text-muted">Nombre</dt>
        <dd class="font-medium"><%= order.shipping_name %></dd>
      </div>
      <div>
        <dt class="text-muted">Email</dt>
        <dd class="font-medium"><%= order.shipping_email %></dd>
      </div>
      <div>
        <dt class="text-muted">Teléfono</dt>
        <dd class="font-medium"><%= order.shipping_phone %></dd>
      </div>
      <div>
        <dt class="text-muted">Dirección</dt>
        <dd class="font-medium"><%= order.shipping_address %></dd>
      </div>
      <div>
        <dt class="text-muted">Ciudad</dt>
        <dd class="font-medium"><%= order.shipping_city %></dd>
      </div>
      <div>
        <dt class="text-muted">Código postal</dt>
        <dd class="font-medium"><%= order.shipping_postal_code %></dd>
      </div>
      <div>
        <dt class="text-muted">País</dt>
        <dd class="font-medium"><%= order.shipping_country %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6 text-center">
    <a href="/" class="btn-primary">Volver al inicio</a>
  </div>
</section>
