<%
  // Page: Resultados de búsqueda (Paso 12, spec §6.13 — sin mockup propio,
  // mismo lenguaje visual que el resto): breadcrumb "Inicio > Búsqueda", H1
  // con la query y el grid reutilizado. Server-rendered, NO AJAX. La query se
  // re-imprime SIEMPRE con la interpolación ESCAPADA de EJS (nunca la cruda)
  // para que texto como "<script>" quede inerte en el HTML. Sin resultados →
  // mensaje amigable (mismo patrón que categoría vacía, §4.6/§6.13). Data via
  // locals — query: string; products: ProductView[] con derivados resueltos.
%>
<div class="mx-auto w-full max-w-screen-2xl px-4 py-6 md:px-6 md:py-8 lg:px-8">
  <%- include("../molecules/breadcrumb", {
    items: [{ label: "Inicio", href: "/" }, { label: "Búsqueda" }],
  }) %>

  <h1 class="mt-6 text-h1 font-bold text-ink md:mt-8">Resultados para '<%= query %>'</h1>

  <% if (products.length > 0) { %>
    <div class="mt-6 md:mt-8">
      <%- include("../organisms/product-grid", { title: "Resultados", products }) %>
    </div>
  <% } else { %>
    <p class="mt-8 text-sm text-muted">No encontramos productos que coincidan con tu búsqueda.</p>
  <% } %>
</div>
