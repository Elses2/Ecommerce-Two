<%
  // Page: Checkout (spec §19, reemplaza el placeholder §4.6/§6.5).
  // Server-rendered, no AJAX. Formulario de envío + método de pago + resumen
  // del carrito. Locals (checkoutController): cart (CartView), checkoutToken
  // (token de idempotencia D6, hidden), values (CheckoutRequestDto — repobla
  // el form tras un error del server), errors (string[] — bloque sobre el
  // form). Los 8 campos de texto usan atoms/input.ejs (soporta value +
  // errorSlot); el token hidden y el select de paymentMethod van inline
  // porque el atom no soporta hidden/select (verificado Fase 0). Sin datos de
  // tarjeta (D9): paymentMethod es solo preferencia, nunca se procesa un pago.
  const hasErrors = errors.length > 0;
%>
<section class="mx-auto w-full max-w-4xl px-4 py-6 md:px-6 md:py-10">
  <a href="/cart" class="inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors hover:text-brand">← Volver al carrito</a>
  <h1 class="mt-3 text-h3 text-ink">Checkout</h1>

  <% if (hasErrors) { %>
    <div data-checkout-errors class="mt-4 rounded-2xl border border-alert bg-white p-4 shadow-sm" role="alert">
      <h2 class="text-sm font-bold text-alert">Revisá los datos del formulario:</h2>
      <ul class="mt-2 list-inside list-disc text-sm text-alert">
        <% errors.forEach((message) => { %>
          <li><%= message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <form data-checkout-form method="POST" action="/checkout" novalidate class="flex flex-col gap-4 rounded-2xl bg-white p-5 shadow-md md:p-6">
      <h2 class="text-h3 text-ink">Datos de envío</h2>

      <%- include("../atoms/input", {
        name: "firstName",
        label: "Nombre",
        placeholder: "Tu nombre",
        autocomplete: "given-name",
        value: values.firstName,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "lastName",
        label: "Apellido",
        placeholder: "Tu apellido",
        autocomplete: "family-name",
        value: values.lastName,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "email",
        type: "email",
        label: "Email",
        placeholder: "Tu email",
        autocomplete: "email",
        value: values.email,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "phone",
        type: "tel",
        label: "Teléfono",
        placeholder: "Tu teléfono",
        autocomplete: "tel",
        value: values.phone,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "address",
        label: "Dirección",
        placeholder: "Tu dirección",
        autocomplete: "street-address",
        value: values.address,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "city",
        label: "Ciudad",
        placeholder: "Tu ciudad",
        autocomplete: "address-level2",
        value: values.city,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "postalCode",
        label: "Código postal",
        placeholder: "Tu código postal",
        autocomplete: "postal-code",
        value: values.postalCode,
        errorSlot: true,
      }) %>
      <%- include("../atoms/input", {
        name: "country",
        label: "País",
        placeholder: "Tu país",
        autocomplete: "country-name",
        value: values.country,
        errorSlot: true,
      }) %>

      <h2 class="mt-2 text-h3 text-ink">Método de pago</h2>

      <div class="flex flex-col gap-1.5">
        <label for="paymentMethod" class="sr-only">Método de pago</label>
        <select
          id="paymentMethod"
          name="paymentMethod"
          class="h-10 w-full rounded-full border border-neutral-300 bg-white px-4 text-sm text-ink transition-colors focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40"
        >
          <option value="" disabled <%= values.paymentMethod ? "" : "selected" %>>Seleccioná un método de pago</option>
          <option value="transfer" <%= values.paymentMethod === "transfer" ? "selected" : "" %>>Transferencia</option>
          <option value="cash_on_delivery" <%= values.paymentMethod === "cash_on_delivery" ? "selected" : "" %>>Pago contra entrega</option>
          <option value="card" <%= values.paymentMethod === "card" ? "selected" : "" %>>Tarjeta</option>
        </select>
        <p data-error-for="paymentMethod" class="hidden text-sm text-alert" role="alert"></p>
      </div>

      <input type="hidden" name="checkoutToken" value="<%= checkoutToken %>" />

      <button type="submit" data-checkout-submit class="btn-primary mt-2 w-full">Confirmar compra</button>
    </form>

    <aside aria-label="Resumen de compra" class="h-fit rounded-2xl bg-white p-5 shadow-md md:p-6">
      <h2 class="text-h3 text-ink">Resumen</h2>
      <ul class="mt-4 flex flex-col gap-3">
        <% cart.items.forEach((item) => { %>
          <li class="flex items-baseline justify-between gap-4 text-sm">
            <span class="text-ink">
              <%= item.name %>
              <span class="text-muted">× <%= item.quantity %></span>
            </span>
            <span class="font-medium text-ink"><%= item.subtotal.toLocaleString("es-AR") %></span>
          </li>
        <% }) %>
      </ul>
      <p class="mt-4 flex items-baseline justify-between border-t border-neutral-200 pt-4">
        <span class="text-ink">Total</span>
        <span class="text-xl font-bold text-ink"><%= cart.total.toLocaleString("es-AR") %></span>
      </p>
    </aside>
  </div>
</section>

<!-- Checkout client-side validation (spec §19): public/ se sirve estático; el build copia public/** → dist/public -->
<script src="/js/checkout-validation.js" defer></script>
