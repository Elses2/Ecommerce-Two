<%
/**
 * Atom: Input (spectsEccomerce/layouts/Input.png)
 * Campo de texto estilo píldora con soporte para variantes clara/oscura y slot de error accesible.
 *
 * @param {string} name - Nombre del atributo 'name' del input (requerido).
 * @param {string} [id] - ID único del input (por defecto toma `name`).
 * @param {string} [type="text"] - Tipo de input HTML (ej: "text", "password", "email").
 * @param {string} [label] - Texto accesible para la etiqueta (se renderiza con sr-only).
 * @param {string} [placeholder=""] - Texto de sugerencia visible.
 * @param {string} [value=""] - Valor inicial del campo.
 * @param {"light" | "dark"} [variant="light"] - Esquema de color visual ("light" para fondos claros, "dark" para graphite).
 * @param {string} [autocomplete] - Atributo/sugerencia de autocompletado HTML.
 * @param {boolean} [errorSlot=false] - Indica si genera un <p> oculto para mensajes de validación cliente.
 */
  const inputName = locals.name;
  const inputId = locals.id ?? locals.name;
  const inputType = locals.type ?? "text";
  const inputVariant = locals.variant ?? "light";
  const inputValue = locals.value ?? "";
  const inputPlaceholder = locals.placeholder ?? "";
  const inputAutocomplete = locals.autocomplete;
  const withErrorSlot = locals.errorSlot === true;
%>
<div class="flex flex-col gap-1.5">
  <% if (locals.label) { %>
    <label for="<%= inputId %>" class="sr-only"><%= locals.label %></label>
  <% } %>
  <input
    type="<%= inputType %>"
    id="<%= inputId %>"
    name="<%= inputName %>"
    value="<%= inputValue %>"
    placeholder="<%= inputPlaceholder %>"
    <% if (inputAutocomplete) { %>autocomplete="<%= inputAutocomplete %>"<% } %>
    class="h-10 w-full rounded-full border px-4 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brand/40 <%= inputVariant === "dark" ? "border-white/25 bg-graphite text-white placeholder-white/50 focus:border-brand" : "border-neutral-300 bg-white text-ink placeholder-muted focus:border-brand" %>"
  />
  <% if (withErrorSlot) { %>
    <p data-error-for="<%= inputId %>" class="hidden text-sm text-alert" role="alert"></p>
  <% } %>
</div>