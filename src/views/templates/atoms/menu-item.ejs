<%
/**
 * Atom: MenuItem (spectsEccomerce/layouts/MenuItem.png)
 * Fila individual de menú que se renderiza como <a> (si recibe href) o como <button>.
 *
 * @param {string} label - Texto a mostrar en la opción (requerido).
 * @param {string} [href] - URL de destino. Si se omite, se renderiza un <button type="button">.
 * @param {string} [icon] - Cadena de texto SVG en formato raw para renderizar el icono.
 * @param {boolean} [active=false] - Marca la opción como activa (añade aria-current y estilo brand).
 */
  const itemLabel = typeof locals.label === "string" ? locals.label : "";
  const itemHref = typeof locals.href === "string" && locals.href ? locals.href : "";
  const itemIcon = typeof locals.icon === "string" && locals.icon ? locals.icon : "";
  const itemActive = locals.active === true;
  const menuItemClasses = [
    "flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm transition-colors",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
    itemActive ? "bg-brand/10 font-medium text-brand" : "text-graphite hover:bg-neutral-100 hover:text-ink",
  ].join(" ");
%>
<% if (itemHref) { %>
  <a
    href="<%= itemHref %>"
    class="<%= menuItemClasses %>"
    <% if (itemActive) { %>aria-current="page"<% } %>
  >
    <% if (itemIcon) { %><span class="[&_svg]:h-4 [&_svg]:w-4" aria-hidden="true"><%- itemIcon %></span><% } %>
    <span><%= itemLabel %></span>
  </a>
<% } else { %>
  <button
    type="button"
    class="<%= menuItemClasses %>"
  >
    <% if (itemIcon) { %><span class="[&_svg]:h-4 [&_svg]:w-4" aria-hidden="true"><%- itemIcon %></span><% } %>
    <span><%= itemLabel %></span>
  </button>
<% } %>