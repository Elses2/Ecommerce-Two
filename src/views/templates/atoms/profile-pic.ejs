<%
/**
 * Atom: ProfilePic (spectsEccomerce/layouts/ProfilePic.png)
 * Foto circular de perfil de usuario con fallback automático a la inicial del nombre.
 *
 * @param {string} [src] - URL de la imagen de perfil.
 * @param {string} [name] - Nombre del usuario para calcular la inicial de fallback.
 * @param {string} [alt] - Texto alternativo de la imagen (por defecto utiliza `name`).
 */
  const picSrc = typeof src === "string" && src ? src : "";
  const picName = typeof name === "string" && name.trim() ? name.trim() : "";
  const picAlt = typeof alt === "string" && alt ? alt : picName;
%>
<% if (picSrc) { %>
  <img
    src="<%= picSrc %>"
    alt="<%= picAlt %>"
    class="h-8 w-8 shrink-0 rounded-full object-cover ring-2 ring-white"
  />
<% } else { %>
  <span
    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-graphite text-xs font-semibold text-white ring-2 ring-white"
    aria-hidden="true"
  ><%= picName.charAt(0).toUpperCase() %></span>
<% } %>