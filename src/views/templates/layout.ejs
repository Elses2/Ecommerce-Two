<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= locals.title ?? "MiEcommerce" %></title>
  <%# Favicon / logo de pestaña (spec §20) %>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body
  class="flex min-h-screen flex-col bg-white font-sans text-ink antialiased"
  data-logged-in="<%= locals.user ? "true" : "false" %>"
>
  <%
    // Shell defaults: cartCount comes from the controller (res.locals);
    // user viene de attachUser (spec §23.3): nombre real o null → el header
    // pinta «Invitado». Ya NO hay hidratación por JS (spec §23.4/§24.3).
    const shellCartCount = typeof locals.cartCount === "number" ? locals.cartCount : 0;
    const shellUser = typeof locals.user === "object" && locals.user !== null ? locals.user : null;
  %>
  <%- include("organisms/header", { cartCount: shellCartCount, user: shellUser }) %>
  <%- include("organisms/header-mobile", { cartCount: shellCartCount, user: shellUser }) %>

  <main class="flex-grow">
    <%- body %>
  </main>

  <%- include("organisms/footer") %>
  <%- include("organisms/footer-mobile") %>

  <!-- Auth client (spec §23): token en localStorage + formularios de auth por
       fetch + render del header. Va ANTES de cart.js porque el carrito usa
       `window.Auth`. -->
  <script src="/js/auth.js" defer></script>

  <!-- Cart AJAX (spec §5/§6.4): loaded ONCE per page from the layout — every
       view rendered through express-ejs-layouts gets the script exactly once;
       pages/cart.ejs and pages/product-detail.ejs no longer ship their own
       copy. public/ is served statically; the build copies public/** → dist/public -->
  <script src="/js/cart.js" defer></script>
</body>
</html>
