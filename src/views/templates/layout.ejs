<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= locals.title ?? "MiEcommerce" %></title>
  <%# Favicon / logo de pestaña (spec §20) %>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="flex min-h-screen flex-col bg-white font-sans text-ink antialiased">
  <%
    // Shell defaults: cartCount comes from injectCartCount (res.locals);
    // userName arranca como "Invitado" y auth.js lo hidrata desde localStorage
    // / GET /api/auth/me (spec §23). Desktop and mobile variants are both
    // rendered here; Tailwind visibility classes pick the active one.
    const shellCartCount = typeof locals.cartCount === "number" ? locals.cartCount : 0;
    const shellUserName = typeof locals.userName === "string" ? locals.userName : "Invitado";
  %>
  <%- include("organisms/header", { cartCount: shellCartCount, userName: shellUserName }) %>
  <%- include("organisms/header-mobile", { cartCount: shellCartCount, userName: shellUserName }) %>

  <main class="flex-grow">
    <%- body %>
  </main>

  <%- include("organisms/footer") %>
  <%- include("organisms/footer-mobile") %>

  <!-- Auth client (spec §23): token en localStorage + formularios de auth por
       fetch + render del header. Va ANTES de cart.js porque el carrito usa
       `window.Auth`. -->
  <script src="/js/auth.js" defer></script>

  <!-- Cart AJAX (spec §5/§6.4): loaded ONCE per page from the layout — every
       view rendered through express-ejs-layouts gets the script exactly once;
       pages/cart.ejs and pages/product-detail.ejs no longer ship their own
       copy. public/ is served statically; the build copies public/** → dist/public -->
  <script src="/js/cart.js" defer></script>
</body>
</html>
