<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barra de Categorías</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Reseteo básico para que no jodan los márgenes por defecto */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f0f0f0; /* Fondo clarito para que resalte la barra */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 50px;
        }

        /* Contenedor principal de la barra */
        .category-nav {
            background-color: #333333; /* Color oscuro similar a la imagen */
            border-radius: 12px;
            display: flex;
            align-items: center;
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            padding: 15px 0;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* Estilo de cada botón/enlace */
        .category-item {
            flex: 1; /* Hace que todos ocupen el mismo ancho */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            text-decoration: none;
            border-right: 1px solid #ffffff; /* La línea separadora */
            transition: all 0.2s ease;
        }

        /* Le sacamos el borde derecho al último elemento para que quede prolijo */
        .category-item:last-child {
            border-right: none;
        }

        /* Efecto hover sutil */
        .category-item:hover {
            opacity: 0.7;
            transform: scale(1.05);
        }

        /* Estilo de los íconos */
        .category-item i {
            font-size: 26px;
            margin-bottom: 8px;
        }

        /* Estilo del texto */
        .category-item span {
            font-size: 13px;
            font-weight: 500;
        }

        /* Responsive básico por si lo abren en el celu */
        @media (max-width: 768px) {
            .category-nav {
                flex-wrap: wrap;
                border-radius: 8px;
                padding: 10px 0;
            }
            .category-item {
                flex: 25%; /* 4 por fila en móviles */
                border-right: none;
                margin-bottom: 15px;
            }
        }
    </style>
</head>
<body>

    <% 
        // Array con la info de cada botón. 
        // Cambiá el valor de "path" por la ruta real de tu backend en Spring Boot.
        const categorias = [
            { nombre: 'Electrónica', icono: 'fa-solid fa-computer', path: '/catalogo/electronica' },
            { nombre: 'Alimentos', icono: 'fa-solid fa-burger', path: '/catalogo/alimentos' },
            { nombre: 'Bebidas', icono: 'fa-solid fa-beer-mug-empty', path: '/catalogo/bebidas' },
            { nombre: 'Indumentaria', icono: 'fa-solid fa-shirt', path: '/catalogo/indumentaria' },
            { nombre: 'Juegos', icono: 'fa-solid fa-gamepad', path: '/catalogo/juegos' },
            { nombre: 'Automotor', icono: 'fa-solid fa-car', path: '/catalogo/automotor' }, // FontAwesome free no tiene un volante lindo, un auto queda bien
            { nombre: 'Hogar', icono: 'fa-solid fa-couch', path: '/catalogo/hogar' },
            { nombre: 'Otros', icono: 'fa-solid fa-gift', path: '/catalogo/otros' }
        ];
    %>

    <nav class="category-nav">
        <% categorias.forEach(categoria => { %>
            <a href="<%= categoria.path %>" class="category-item">
                <i class="<%= categoria.icono %>"></i>
                <span><%= categoria.nombre %></span>
            </a>
        <% }) %>
    </nav>

</body>
</html>
