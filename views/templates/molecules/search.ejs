<%
  // Molecule: search form (spectsEccomerce/layouts/Search.svg, light variant).
  // GET form toward /search per spec 6.13 (input name must stay `query`).
  // Placeholder, value and action all arrive via include locals.
  const searchAction = typeof action === "string" && action ? action : "/search";
  const searchPlaceholder = typeof placeholder === "string" ? placeholder : "";
  const searchValue = typeof value === "string" ? value : "";
%>
<form action="<%= searchAction %>" method="GET" role="search" class="relative w-full">
  <input
    type="search"
    name="query"
    value="<%= searchValue %>"
    placeholder="<%= searchPlaceholder %>"
    autocomplete="off"
    aria-label="Buscar productos"
    class="h-8 w-full rounded-full border border-[#dfdfdf] bg-white pl-4 pr-10 text-sm text-ink placeholder:text-ink/60 focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
  />
  <button
    type="submit"
    aria-label="Buscar"
    class="absolute inset-y-0 right-0 flex w-10 cursor-pointer items-center justify-center rounded-full text-[#808080] transition-colors hover:text-ink"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-4 w-4"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
  </button>
</form>
