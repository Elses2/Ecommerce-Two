<%
  // Molecule: cart button + badge counter (spectsEccomerce/layouts/Cart.png).
  // Graphite circle with a white filled cart and the red numeric badge.
  const cartHref = typeof href === "string" && href ? href : "/cart";
  const cartCountValue = typeof count === "number" && count >= 0 ? count : 0;
%>
<a
  href="<%= cartHref %>"
  class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-graphite text-white transition-colors hover:bg-graphite/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-graphite"
  aria-label="Carrito de compras, <%= cartCountValue %> <%= cartCountValue === 1 ? 'producto' : 'productos' %>"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="h-5 w-5"
    aria-hidden="true"
  >
    <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.6-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" />
  </svg>
  <%- include("../atoms/badge-counter", { count: cartCountValue }) %>
</a>
