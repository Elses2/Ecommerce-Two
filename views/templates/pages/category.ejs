<%
  // Page: Categoría (spec §4.6/Paso 11 — sin mockup propio, mismo lenguaje
  // visual que el resto): breadcrumb "Inicio > <categoría>" arriba, H1 con el
  // nombre de la categoría y el grid reutilizado (mismo organism que "Te puede
  // interesar" / relacionados). Data via locals — categoryName: string;
  // products: ProductView[] (fallback/derived attrs ya resueltos por el
  // service). Elección documentada: product-grid NO maneja estado vacío (el
  // patrón del proyecto lo deja en la página, igual que el mensaje de
  // relacionados en product-detail §6.8), así que si la categoría no tiene
  // productos se renderiza el mensaje amigable de §4.6 en lugar del grid.
%>
<div class="mx-auto w-full max-w-screen-2xl px-4 py-6 md:px-6 md:py-8 lg:px-8">
  <%- include("../molecules/breadcrumb", {
    items: [{ label: "Inicio", href: "/" }, { label: categoryName }],
  }) %>

  <h1 class="mt-6 text-h1 font-bold text-ink md:mt-8"><%= categoryName %></h1>

  <% if (products.length > 0) { %>
    <div class="mt-6 md:mt-8">
      <%- include("../organisms/product-grid", { title: "Productos", products }) %>
    </div>
  <% } else { %>
    <p class="mt-8 text-sm text-muted">No hay productos en esta categoría todavía.</p>
  <% } %>
</div>
