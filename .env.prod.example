# =============================================================================
# Variables de entorno para producción (spec §16, §21)
# =============================================================================
# Copiar a .env en el servidor y llenar con valores reales.
# NUNCA comitear .env con valores reales.

# Secreto de firma de los JWT — generar uno largo y aleatorio (>= 32 chars):
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Contraseña de Redis (carrito, spec §24). Usar hexadecimal para no romper REDIS_URL:
#   openssl rand -hex 32
REDIS_PASSWORD=

# Token del túnel Cloudflare — obtenerlo desde Zero Trust de Cloudflare
TUNNEL_TOKEN=
