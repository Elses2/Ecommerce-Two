# =============================================================================
# Variables de entorno para producción (spec §16, §21)
# =============================================================================
# Copiar a .env en el servidor y llenar con valores reales.
# NUNCA comitear .env con valores reales.

# Secreto de firma de los JWT — generar uno largo y aleatorio (>= 32 chars):
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Cookie de sesión (spec §16, enmienda cookie httpOnly): true SOLO detrás de
# HTTPS (junto a CSP_UPGRADE_INSECURE=true). Con http://IP:PUERTO el navegador
# descarta la cookie y la sesión no se mantiene.
COOKIE_SECURE=false

# Contraseña de Redis (carrito, spec §24). Usar hexadecimal para no romper REDIS_URL:
#   openssl rand -hex 32
REDIS_PASSWORD=

# CSP (spec §22.2): forzar HTTPS en subrecursos. Default false.
# Dejalo en false si el acceso es por http://IP:PUERTO (evita que el navegador suba /css y /js a https).
CSP_UPGRADE_INSECURE=false

# Token del túnel Cloudflare — obtenerlo desde Zero Trust de Cloudflare
TUNNEL_TOKEN=
